{
  "name": "enhanced-for-todoist-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "A native window around Enhanced for Todoist, with a global quick-add shortcut. It loads the hosted site, so the site's updates are the app's updates.",
  "author": "Jules-Valentin Bertolino",
  "license": "MIT",
  "homepage": "https://github.com/julesvbertolino/todoist-enhanced-desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.julesbertolino.todoistenhanced.desktop",
    "productName": "Enhanced for Todoist",
    "files": ["main.js", "preload.js", "package.json"],
    "directories": { "buildResources": "build" },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "artifactName": "Enhanced-for-Todoist-${arch}.${ext}"
    }
  }
}
